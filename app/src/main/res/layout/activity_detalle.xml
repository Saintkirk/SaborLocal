<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_pantalla"
    tools:context=".AgregarActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtTituloAgregar"
                style="@style/Estilo.Titulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/agregar_titulo" />

            <ImageButton
                android:id="@+id/btnVolverAgregar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:background="@android:color/transparent"
                android:contentDescription="@string/cd_volver" />
        </LinearLayout>

        <EditText
            android:id="@+id/edtNombreRestaurante"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/agregar_hint_nombre"
            android:textColorHint="@color/texto_secundario"
            android:textColor="@color/texto_principal"
            android:inputType="textCapWords" />

        <Spinner
            android:id="@+id/spnTipoComida"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:entries="@array/tipos_comida" />

        <EditText
            android:id="@+id/edtComuna"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/agregar_hint_comuna"
            android:textColorHint="@color/texto_secundario"
            android:textColor="@color/texto_principal"
            android:inputType="textCapWords" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/agregar_puntaje"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/texto_principal" />

        <RadioGroup
            android:id="@+id/rgPuntaje"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbPuntaje1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/puntaje_1"
                android:textColor="@color/texto_principal" />

            <RadioButton
                android:id="@+id/rbPuntaje2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/puntaje_2"
                android:textColor="@color/texto_principal" />

            <RadioButton
                android:id="@+id/rbPuntaje3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/puntaje_3"
                android:textColor="@color/texto_principal" />

            <RadioButton
                android:id="@+id/rbPuntaje4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/puntaje_4"
                android:textColor="@color/texto_principal" />

            <RadioButton
                android:id="@+id/rbPuntaje5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/puntaje_5"
                android:textColor="@color/texto_principal" />
        </RadioGroup>

        <EditText
            android:id="@+id/edtComentario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="top|start"
            android:hint="@string/agregar_hint_comentario"
            android:textColorHint="@color/texto_secundario"
            android:textColor="@color/texto_principal"
            android:inputType="textMultiLine"
            android:minLines="4" />

        <Button
            android:id="@+id/btnGuardarResena"
            style="@style/Estilo.Boton.Principal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/agregar_guardar" />

    </LinearLayout>

</ScrollView>