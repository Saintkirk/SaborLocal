<?xml version="1.0" encoding="utf-8"?>
<!--
    ScrollView: deja deslizar el contenido cuando no cabe en la pantalla.
    id: main. background: color de fondo desde colors.xml.
    tools:context: este layout lo usa DetalleActivity (solo vista previa).
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_pantalla"
    tools:context=".DetalleActivity">

    <!--
        LinearLayout: contenido en columna.
        layout_height: alto justo para lo que tiene adentro.
        padding: 24dp (dp, no sp: es un espacio, no un texto).
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!--
            ImageButton: volver a la lista. id: btnVolverDetalle.
            layout_gravity: alineado a la derecha, igual que en Agregar.
            app:tint: color del ícono desde colors.xml, para que tenga contraste en modo claro y oscuro.
            Usa el texto cd_volver ya existente en strings.xml.
        -->
        <ImageButton
            android:id="@+id/btnVolverDetalle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="@android:color/transparent"
            app:tint="@color/texto_principal"
            android:contentDescription="@string/cd_volver" />

        <!--
            ImageView: foto del restaurante.
            id: imgCaratulaDetalle.
            layout_width / layout_height: fijo de 200dp.
            layout_gravity: centrada en horizontal.
            src: ícono de la app, como ejemplo.
        -->
        <ImageView
            android:id="@+id/imgCaratulaDetalle"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center_horizontal"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@string/cd_caratula" />

        <!--
            TextView: nombre del restaurante.
            id: txtRestauranteDetalle.
            textSize: 26sp. textStyle: negrita.
        -->
        <TextView
            android:id="@+id/txtRestauranteDetalle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/ejemplo_nombre_1"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/texto_principal" />

        <!-- TextView: tipo de comida y comuna. id: txtTipoDetalle. textColor: texto secundario. -->
        <TextView
            android:id="@+id/txtTipoDetalle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ejemplo_tipo_1"
            android:textSize="18sp"
            android:textColor="@color/texto_secundario" />

        <!-- TextView: puntaje. id: txtPuntajeDetalle. textColor: color primario del tema. -->
        <TextView
            android:id="@+id/txtPuntajeDetalle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ejemplo_puntaje_1"
            android:textSize="18sp"
            android:textColor="@color/primario" />

        <!-- TextView: veces visitado. id: txtVisitasDetalle. -->
        <TextView
            android:id="@+id/txtVisitasDetalle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/detalle_visitas"
            android:textSize="16sp"
            android:textColor="@color/texto_secundario" />

        <!--
            TextView: comentario completo de la reseña.
            id: txtComentarioDetalle.
            layout_width: igual al de su contenedor, para que el texto baje de línea.
            layout_marginTop: espacio por fuera, arriba.
        -->
        <TextView
            android:id="@+id/txtComentarioDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/detalle_comentario"
            android:textSize="16sp"
            android:textColor="@color/texto_principal" />

        <!--
            Switch: interruptor que se enciende o se apaga.
            id: swFavoritoDetalle.
            text: lo que se lee al lado del interruptor.
            checked: aparece marcado al abrir la pantalla.
            minHeight: área táctil de 48dp.
        -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swFavoritoDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="48dp"
            android:text="@string/detalle_favorito"
            android:textColor="@color/texto_principal"
            android:checked="true" />

        <!-- Button: editar la reseña. id: btnEditarDetalle. Estilo propio Estilo.Boton.Principal. -->
        <Button
            android:id="@+id/btnEditarDetalle"
            style="@style/Estilo.Boton.Principal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/detalle_editar" />

        <!--
            Button: eliminar la reseña.
            id: btnEliminarDetalle.
            layout_height: wrap_content, alto justo para su texto.
        -->
        <Button
            android:id="@+id/btnEliminarDetalle"
            style="@style/Estilo.Boton.Principal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/detalle_eliminar" />

    </LinearLayout>

</ScrollView>
