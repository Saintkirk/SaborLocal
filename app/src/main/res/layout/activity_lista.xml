<?xml version="1.0" encoding="utf-8"?>
<!--
    LinearLayout: pantalla en columna, encabezado arriba y lista desplazable abajo.
    id: main. background: color de fondo desde colors.xml.
    tools:context: este layout lo usa ListaActivity (solo vista previa).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo_pantalla"
    tools:context=".ListaActivity">

    <!--
        LinearLayout: encabezado con el título y tres botones de acción.
        orientation: horizontal. gravity: centra en vertical.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <!-- TextView: título. id: txtTituloLista. Estilo propio Estilo.Titulo. -->
        <TextView
            android:id="@+id/txtTituloLista"
            style="@style/Estilo.Titulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/lista_titulo" />

        <!--
            ImageButton: abre las recomendaciones con IA. id: btnIA.
            app:tint: color del ícono desde colors.xml, para que se vea bien en modo claro y oscuro.
        -->
        <ImageButton
            android:id="@+id/btnIA"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/star_big_on"
            android:background="@android:color/transparent"
            app:tint="@color/texto_principal"
            android:contentDescription="@string/cd_ia" />

        <!-- ImageButton: agregar una reseña. id: btnAgregar. -->
        <ImageButton
            android:id="@+id/btnAgregar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_input_add"
            android:background="@android:color/transparent"
            app:tint="@color/texto_principal"
            android:contentDescription="@string/cd_agregar" />

        <!-- ImageButton: cerrar sesión. id: btnSalir. -->
        <ImageButton
            android:id="@+id/btnSalir"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="@android:color/transparent"
            app:tint="@color/texto_principal"
            android:contentDescription="@string/cd_salir" />

    </LinearLayout>

    <!--
        ScrollView: lista desplazable de reseñas.
        layout_height: 0dp con layout_weight 1, ocupa el espacio que deja el encabezado.
    -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- LinearLayout: contiene las tarjetas, una bajo otra. paddingHorizontal: margen a los lados. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <!--
                LinearLayout: tarjeta de la reseña 1 (foto, datos y botón Ver).
                background: color de tarjeta desde colors.xml.
                layout_marginBottom: espacio por fuera, abajo.
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:layout_marginBottom="8dp"
                android:background="@color/fondo_tarjeta">

                <!-- ImageView: foto del restaurante, de ejemplo. -->
                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@mipmap/ic_launcher"
                    android:contentDescription="@string/cd_caratula" />

                <!-- LinearLayout: nombre, tipo y puntaje, en columna. layout_weight: ocupa el espacio sobrante. -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ejemplo_nombre_1"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/texto_principal" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ejemplo_tipo_1"
                        android:textSize="14sp"
                        android:textColor="@color/texto_secundario" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ejemplo_puntaje_1"
                        android:textSize="14sp"
                        android:textColor="@color/primario" />

                </LinearLayout>

                <!-- Button: ver el detalle. id: btnVerRestaurante1. Estilo propio Estilo.Boton.Principal. -->
                <Button
                    android:id="@+id/btnVerRestaurante1"
                    style="@style/Estilo.Boton.Principal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lista_ver" />

            </LinearLayout>

            <!-- LinearLayout: tarjeta de la reseña 2, misma estructura que la 1. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:layout_marginBottom="8dp"
                android:background="@color/fondo_tarjeta">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@mipmap/ic_launcher"
                    android:contentDescription="@string/cd_caratula" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ejemplo_nombre_2"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/texto_principal" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ejemplo_tipo_2"
                        android:textSize="14sp"
                        android:textColor="@color/texto_secundario" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ejemplo_puntaje_2"
                        android:textSize="14sp"
                        android:textColor="@color/primario" />

                </LinearLayout>

                <Button
                    android:id="@+id/btnVerRestaurante2"
                    style="@style/Estilo.Boton.Principal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lista_ver" />

            </LinearLayout>

            <!-- LinearLayout: tarjeta de la reseña 3, misma estructura que la 1. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:layout_marginBottom="8dp"
                android:background="@color/fondo_tarjeta">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@mipmap/ic_launcher"
                    android:contentDescription="@string/cd_caratula" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ejemplo_nombre_3"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/texto_principal" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ejemplo_tipo_3"
                        android:textSize="14sp"
                        android:textColor="@color/texto_secundario" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ejemplo_puntaje_3"
                        android:textSize="14sp"
                        android:textColor="@color/primario" />

                </LinearLayout>

                <Button
                    android:id="@+id/btnVerRestaurante3"
                    style="@style/Estilo.Boton.Principal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lista_ver" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>