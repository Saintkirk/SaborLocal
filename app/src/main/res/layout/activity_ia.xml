<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo_pantalla"
    tools:context=".IaActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/txtTituloIA"
            style="@style/Estilo.Titulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/ia_titulo" />

        <ImageButton
            android:id="@+id/btnVolverIA"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="@android:color/transparent"
            android:contentDescription="@string/cd_volver" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ia_pregunta"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/texto_principal" />

        <EditText
            android:id="@+id/edtPreferenciaIA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="top|start"
            android:hint="@string/ia_hint"
            android:textColorHint="@color/texto_secundario"
            android:textColor="@color/texto_principal"
            android:inputType="textMultiLine"
            android:minLines="3" />

        <Button
            android:id="@+id/btnRecomendarIA"
            style="@style/Estilo.Boton.Principal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:text="@string/ia_boton" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/ia_etiqueta_respuesta"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/texto_principal" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:padding="12dp"
            android:background="@color/fondo_respuesta">

            <TextView
                android:id="@+id/txtRespuestaIA"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ia_respuesta_ejemplo"
                android:textSize="16sp"
                android:textColor="@color/texto_principal" />
        </ScrollView>
    </LinearLayout>

</LinearLayout>