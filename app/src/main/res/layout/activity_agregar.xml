<?xml version="1.0" encoding="utf-8"?>
<!--
    ScrollView: deja deslizar el formulario cuando el teclado o la pantalla no alcanzan.
    id: main. background: color de fondo desde colors.xml.
    tools:context: este layout lo usa AgregarActivity (solo vista previa).
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_pantalla"
    tools:context=".AgregarActivity">

    <!--
        LinearLayout: el formulario, en columna.
        padding: espacio por dentro, en los cuatro lados.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!--
            LinearLayout: encabezado con título y botón volver.
            orientation: horizontal. gravity: centra en vertical.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- TextView: título. id: txtTituloAgregar. Estilo propio Estilo.Titulo. -->
            <TextView
                android:id="@+id/txtTituloAgregar"
                style="@style/Estilo.Titulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/agregar_titulo" />

            <!--
                ImageButton: volver a la lista. id: btnVolverAgregar.
                app:tint: color del ícono desde colors.xml, para que tenga contraste en modo claro y oscuro.
            -->
            <ImageButton
                android:id="@+id/btnVolverAgregar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:background="@android:color/transparent"
                app:tint="@color/texto_principal"
                android:contentDescription="@string/cd_volver" />
        </LinearLayout>

        <!--
            EditText: nombre del restaurante.
            id: edtNombreRestaurante.
            autofillHints: name.
            inputType: textCapWords, mayúscula al inicio de cada palabra.
        -->
        <EditText
            android:id="@+id/edtNombreRestaurante"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="48dp"
            android:autofillHints="name"
            android:hint="@string/agregar_hint_nombre"
            android:textColorHint="@color/texto_secundario"
            android:textColor="@color/texto_principal"
            android:inputType="textCapWords" />

        <!--
            Spinner: lista desplegable para elegir el tipo de comida.
            id: spnTipoComida.
            entries: las opciones vienen de tipos_comida, en res/values/arrays.xml.
        -->
        <Spinner
            android:id="@+id/spnTipoComida"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:entries="@array/tipos_comida" />

        <!-- EditText: comuna. id: edtComuna. autofillHints: addressLocality. -->
        <EditText
            android:id="@+id/edtComuna"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:autofillHints="addressLocality"
            android:hint="@string/agregar_hint_comuna"
            android:textColorHint="@color/texto_secundario"
            android:textColor="@color/texto_principal"
            android:inputType="textCapWords" />

        <!--
            TextView: etiqueta del puntaje.
            textStyle: negrita.
        -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/agregar_puntaje"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/texto_principal" />

        <!--
            RadioGroup: puntaje del 1 al 5, solo uno puede quedar marcado.
            id: rgPuntaje. orientation: horizontal.
        -->
        <RadioGroup
            android:id="@+id/rgPuntaje"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- RadioButton: puntaje 1. id: rbPuntaje1. minHeight: área táctil de 48dp. -->
            <RadioButton
                android:id="@+id/rbPuntaje1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/puntaje_1"
                android:textColor="@color/texto_principal" />

            <RadioButton
                android:id="@+id/rbPuntaje2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/puntaje_2"
                android:textColor="@color/texto_principal" />

            <RadioButton
                android:id="@+id/rbPuntaje3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/puntaje_3"
                android:textColor="@color/texto_principal" />

            <!-- RadioButton: puntaje 4. checked: viene marcado al abrir la pantalla. -->
            <RadioButton
                android:id="@+id/rbPuntaje4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:checked="true"
                android:text="@string/puntaje_4"
                android:textColor="@color/texto_principal" />

            <RadioButton
                android:id="@+id/rbPuntaje5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/puntaje_5"
                android:textColor="@color/texto_principal" />
        </RadioGroup>

        <!--
            EditText: comentario de la reseña.
            id: edtComentario.
            importantForAutofill: no, es texto libre y no hay nada que autocompletar.
            gravity: el texto empieza arriba a la izquierda.
            inputType: textMultiLine, la tecla Enter baja de línea.
            minLines: muestra por lo menos 4 líneas de alto.
        -->
        <EditText
            android:id="@+id/edtComentario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:importantForAutofill="no"
            android:gravity="top|start"
            android:hint="@string/agregar_hint_comentario"
            android:textColorHint="@color/texto_secundario"
            android:textColor="@color/texto_principal"
            android:inputType="textMultiLine"
            android:minLines="4" />

        <!-- Button: guarda la reseña. id: btnGuardarResena. Estilo propio Estilo.Boton.Principal. -->
        <Button
            android:id="@+id/btnGuardarResena"
            style="@style/Estilo.Boton.Principal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/agregar_guardar" />

    </LinearLayout>

</ScrollView>