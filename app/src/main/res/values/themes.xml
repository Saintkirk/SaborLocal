<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema base de la aplicación en modo claro -->
    <style name="Base.Theme.SaborLocal" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primario</item>
        <item name="colorOnPrimary">@color/texto_sobre_primario</item>
        <item name="android:statusBarColor">@color/primario</item>
    </style>

    <style name="Theme.SaborLocal" parent="Base.Theme.SaborLocal" />

    <!-- Estilo propio para los botones principales -->
    <style name="Estilo.Boton.Principal" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primario</item>
        <item name="android:textColor">@color/texto_sobre_primario</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Estilo propio para títulos de pantalla -->
    <style name="Estilo.Titulo" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/texto_principal</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>